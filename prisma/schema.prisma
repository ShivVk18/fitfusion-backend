generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String       @id @default(uuid())
  firstName       String?
  secondName      String?
  email           String       @unique
  username        String       @unique
  password        String
  age             String?
  gender          String?
  weight          String?
  height          String?
  fitnessGoal     String?
  experienceLevel String?
  injuries        String?
  refreshToken    String?
  signInType      Int          @default(1)
  isProfileSetup  Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  aiHistories     AIHistory[]
  diets           Diet[]
  progress        Progress[]
  recoveries      Recovery[]
  workouts        Workout[]
  workoutLogs     WorkoutLog[]

  @@index([email])
  @@index([username])
}

model Workout {
  id          String       @id @default(uuid())
  userId      String
  planName    String
  splitType   String
  createdByAI Boolean      @default(true)
  duration    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  days        WorkoutDay[]
  workoutLogs WorkoutLog[]

  @@index([userId])
}

model WorkoutDay {
  id        String     @id @default(uuid())
  workoutId String
  day       String
  focus     String
  exercises Exercise[]
  workout   Workout    @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@index([workoutId])
}

model Exercise {
  id    String     @id @default(uuid())
  dayId String
  name  String
  sets  String
  reps  String
  rest  String
  day   WorkoutDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([dayId])
}

model WorkoutLog {
  id        String        @id @default(uuid())
  userId    String
  workoutId String?
  date      String
  duration  String?
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  exercises ExerciseLog[]
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout   Workout?      @relation(fields: [workoutId], references: [id])

  @@index([userId])
  @@index([userId, date])
}

model ExerciseLog {
  id           String     @id @default(uuid())
  workoutLogId String
  name         String
  sets         String
  reps         String
  weight       String
  workoutLog   WorkoutLog @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)

  @@index([workoutLogId])
}

model Progress {
  id        String   @id @default(uuid())
  userId    String
  weight    String
  bodyFat   String?
  chest     String?
  waist     String?
  biceps    String?
  date      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
}

model Diet {
  id          String   @id @default(uuid())
  userId      String
  calories    String
  protein     String
  carbs       String
  fats        String
  dietType    String?
  goal        String?
  meals       Json?
  mealTimings Json?
  date        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Recovery {
  id            String   @id @default(uuid())
  userId        String
  sleepHours    Float
  soreness      Int
  fatigue       Int
  stress        Int
  hydration     Float
  recoveryScore Float
  date          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
}

model AIHistory {
  id           String   @id @default(uuid())
  userId       String
  requestType  String
  prompt       String
  requestData  Json?
  responseData Json?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, requestType])
}
